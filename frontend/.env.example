# Frontend environment (copy to frontend/.env.local)
# Never commit frontend/.env.local

# Public API base URL (no trailing slash)
# Used by frontend/src/lib/api.ts (axios `api` client, apiUrl, mediaUrl)
#
# Why NEXT_PUBLIC_?
# In Next.js, only env vars prefixed with NEXT_PUBLIC_ are available in browser
# (client) code. Login, posts, and other fetch calls run in the client, so the
# API URL must use this prefix. The URL itself is not a secret - anyone can see
# network requests in DevTools anyway. Never put passwords or JWT secrets here.
NEXT_PUBLIC_API_URL=http://localhost:5000
