# Backend environment (copy to backend/.env and fill in real values)
# Never commit backend/.env

# API listen port
PORT=5000

# Optional reference only — the app does not read these yet.
# Keep the same values inside MONGODB_URI below.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MongoDB Atlas or local connection string (required)
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mockbook?retryWrites=true&w=majority
# Example local:
# MONGODB_URI=mongodb://127.0.0.1:27017/mockbook
MONGODB_URI=

# Secret used to sign JWTs (use a long random string in real use)
ACCESS_TOKEN_SECRET=
