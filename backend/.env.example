# Backend environment (copy to backend/.env and fill in real values)
# Never commit backend/.env

# API listen port
PORT=5000

# Optional reference only - the app does not read these yet.
# Keep the same values inside MONGODB_URI below.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MongoDB Atlas or local connection string (required)
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/xivi?retryWrites=true&w=majority
# Example local:
# MONGODB_URI=mongodb://127.0.0.1:27017/xivi
MONGODB_URI=

# Secret used to sign access JWTs. Use a long random string.
ACCESS_TOKEN_SECRET=

# Secret used to sign refresh JWTs. Prefer a different value from ACCESS_TOKEN_SECRET.
# If unset, the API falls back to ACCESS_TOKEN_SECRET (fine for local; set separately in production).
REFRESH_TOKEN_SECRET=

# JWT lifetimes (jsonwebtoken format, e.g. 15m, 1h, 1d, 7d). Defaults shown.
ACCESS_TOKEN_EXPIRES=1d
REFRESH_TOKEN_EXPIRES=7d

# Browser origin(s) allowed by CORS (comma-separated if multiple)
# Must match the URL you open for the Next.js app (scheme + host + port).
FRONTEND_URL=http://localhost:3000

# Public API origin used in OAuth redirect_uri (no trailing slash).
# Must match the URL registered in each OAuth app’s console.
# Example local: http://localhost:5000
API_PUBLIC_URL=http://localhost:5000

# OAuth (optional). Leave blank to hide that provider’s button on login/register.
# Callback URLs to register with each provider:
#   {API_PUBLIC_URL}/auth/google/callback
#   {API_PUBLIC_URL}/auth/github/callback
#   {API_PUBLIC_URL}/auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ImageKit (server-side uploads). Get keys from ImageKit dashboard → Developer options.
# Private key must never be exposed to the frontend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Comma-separated emails promoted to role=admin on register/login (and used by seed:admins defaults).
# Demo defaults if unset: admin@yopmail.com, admin@xivi.com
ADMIN_EMAILS=admin@yopmail.com,admin@xivi.com

