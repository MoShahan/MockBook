# Backend environment (copy to backend/.env and fill in real values)
# Never commit backend/.env

# API listen port
PORT=5000

# Optional reference only — the app does not read these yet.
# Keep the same values inside MONGODB_URI below.
MONGODB_USERNAME=
MONGODB_PASSWORD=

# MongoDB Atlas or local connection string (required)
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/mockbook?retryWrites=true&w=majority
# Example local:
# MONGODB_URI=mongodb://127.0.0.1:27017/mockbook
MONGODB_URI=

# Secret used to sign JWTs (use a long random string in real use)
ACCESS_TOKEN_SECRET=

# Browser origin(s) allowed by CORS (comma-separated if multiple)
# Must match the URL you open for the Next.js app (scheme + host + port).
FRONTEND_URL=http://localhost:3000

# ImageKit (server-side uploads). Get keys from ImageKit dashboard → Developer options.
# Private key must never be exposed to the frontend.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

